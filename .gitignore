# ==========================================
# Git Ignore for Food Classification Project
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- OS Specific Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Large Datasets ---
# The raw training images (~360 MB, thousands of files) should not be pushed to GitHub.
Indian Food Images/

# --- Model Checkpoints ---
# Ignore intermediate base model, keep ONLY the final fine-tuned model
outputs/checkpoints/best_model.keras
!outputs/checkpoints/best_model_finetuned.keras

# --- Logs & Temporary Files ---
*.log
scratch/
temp/
tmp/
